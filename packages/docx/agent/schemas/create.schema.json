{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "comments": {
          "type": "string"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "text": {
          "type": "string"
        },
        "block_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "block_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "numbered": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "numbered_list"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "string"
          }
        },
        "block_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "bulleted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "bulleted_list"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "string"
          }
        },
        "block_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "style": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            }
          }
        },
        "block_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "blocks"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "blocks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/heading"
          },
          {
            "$ref": "#/$defs/paragraph"
          },
          {
            "$ref": "#/$defs/numbered"
          },
          {
            "$ref": "#/$defs/bulleted"
          },
          {
            "$ref": "#/$defs/table"
          }
        ]
      }
    },
    "document_id": {
      "$ref": "#/$defs/identifier"
    }
  }
}
