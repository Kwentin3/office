{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$defs":{
  "replace":{"type":"object","additionalProperties":false,"required":["type","target_id","old","new"],"properties":{"type":{"const":"replace_text"},"target_id":{"type":"string"},"old":{"type":"string","minLength":1},"new":{"type":"string"}}},
  "insert":{"type":"object","additionalProperties":false,"required":["type","target_id","text","copy_properties"],"properties":{"type":{"const":"insert_paragraph_after"},"target_id":{"type":"string"},"text":{"type":"string","minLength":1},"copy_properties":{"type":"boolean"}}},
  "setcell":{"type":"object","additionalProperties":false,"required":["type","target_id","text"],"properties":{"type":{"const":"set_cell_text"},"target_id":{"type":"string"},"text":{"type":"string"}}},
  "clone":{"type":"object","additionalProperties":false,"required":["type","target_id","cell_texts"],"properties":{"type":{"const":"clone_row_after"},"target_id":{"type":"string"},"cell_texts":{"type":"array","items":{"type":"string"}}}},
  "reorder":{"type":"object","additionalProperties":false,"required":["type","table_id","row_ids"],"properties":{"type":{"const":"reorder_rows"},"table_id":{"type":"string"},"row_ids":{"type":"array","items":{"type":"string"}}}},
  "delete":{"type":"object","additionalProperties":false,"required":["type","target_id"],"properties":{"type":{"const":"delete_row"},"target_id":{"type":"string"}}},
  "operation":{"oneOf":[{"$ref":"#/$defs/replace"},{"$ref":"#/$defs/insert"},{"$ref":"#/$defs/setcell"},{"$ref":"#/$defs/clone"},{"$ref":"#/$defs/reorder"},{"$ref":"#/$defs/delete"}]},
  "selector":{"type":"object","additionalProperties":false,"required":["kind","text"],"properties":{"kind":{"enum":["paragraph","heading","cell","row"]},"text":{"type":"string"}}},
    "sort":{"type":"object","additionalProperties":false,"required":["type","table_id","row_ids","keys_by_row_id","descending","prefix_row_ids","suffix_row_ids"],"properties":{"type":{"const":"sort_rows"},"table_id":{"type":"string"},"row_ids":{"type":"array","maxItems":10000,"items":{"type":"string"}},"keys_by_row_id":{"type":"object","additionalProperties":{"type":["string","number"]}},"descending":{"type":"boolean"},"prefix_row_ids":{"type":"array","maxItems":10000,"items":{"type":"string"}},"suffix_row_ids":{"type":"array","maxItems":10000,"items":{"type":"string"}}}},
  "totals":{"type":"object","additionalProperties":false,"required":["type","rows","grand_total_target_id"],"properties":{"type":{"const":"table_totals"},"rows":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["quantity","unit_price","total_target_id"],"properties":{"quantity":{"type":"number"},"unit_price":{"type":"number"},"total_target_id":{"type":"string"}}}},"grand_total_target_id":{"type":"string"}}},
  "fill":{"type":"object","additionalProperties":false,"required":["type","items","replacement"],"properties":{"type":{"const":"fill_missing"},"items":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["target_id","value"],"properties":{"target_id":{"type":"string"},"value":{"type":"string"}}}},"replacement":{"type":"string"}}},
  "bulk":{"type":"object","additionalProperties":false,"required":["type","items"],"properties":{"type":{"const":"bulk_replace"},"items":{"type":"array","maxItems":10000,"items":{"type":"object","additionalProperties":false,"required":["target_id","value"],"properties":{"target_id":{"type":"string"},"value":{"type":"string"}}}}}}
 },
 "type":"object","oneOf":[
  {"additionalProperties":false,"required":["operations"],"properties":{"operations":{"type":"array","minItems":1,"maxItems":1000,"items":{"$ref":"#/$defs/operation"}}}},
  {"additionalProperties":false,"required":["intents"],"properties":{"intents":{"type":"array","minItems":1,"maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["selector","operation"],"properties":{"selector":{"$ref":"#/$defs/selector"},"operation":{"type":"object"}}}}}},
  {"additionalProperties":false,"required":["transform"],"properties":{"transform":{"oneOf":[{"$ref":"#/$defs/sort"},{"$ref":"#/$defs/totals"},{"$ref":"#/$defs/fill"},{"$ref":"#/$defs/bulk"}]}}}
 ]
}
