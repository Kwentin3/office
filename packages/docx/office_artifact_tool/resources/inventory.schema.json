{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "artifact_type",
    "view",
    "source_sha256",
    "features",
    "mutation_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "ok"
    },
    "artifact_type": {
      "const": "docx"
    },
    "view": {
      "const": "inventory"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracked_changes",
        "content_controls",
        "comments",
        "images",
        "fields",
        "alt_chunks",
        "text_boxes",
        "merged_cells",
        "hyperlinks",
        "external_relationships",
        "headers",
        "footers",
        "footnotes",
        "endnotes",
        "charts",
        "smartart",
        "embedded_packages",
        "ole_objects",
        "activex",
        "document_protection",
        "macros",
        "signatures"
      ],
      "properties": {
        "tracked_changes": {
          "type": "integer",
          "minimum": 0
        },
        "content_controls": {
          "type": "integer",
          "minimum": 0
        },
        "comments": {
          "type": "integer",
          "minimum": 0
        },
        "images": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "integer",
          "minimum": 0
        },
        "alt_chunks": {
          "type": "integer",
          "minimum": 0
        },
        "text_boxes": {
          "type": "integer",
          "minimum": 0
        },
        "merged_cells": {
          "type": "integer",
          "minimum": 0
        },
        "hyperlinks": {
          "type": "integer",
          "minimum": 0
        },
        "external_relationships": {
          "type": "integer",
          "minimum": 0
        },
        "headers": {
          "type": "integer",
          "minimum": 0
        },
        "footers": {
          "type": "integer",
          "minimum": 0
        },
        "footnotes": {
          "type": "integer",
          "minimum": 0
        },
        "endnotes": {
          "type": "integer",
          "minimum": 0
        },
        "charts": {
          "type": "integer",
          "minimum": 0
        },
        "smartart": {
          "type": "integer",
          "minimum": 0
        },
        "embedded_packages": {
          "type": "integer",
          "minimum": 0
        },
        "ole_objects": {
          "type": "integer",
          "minimum": 0
        },
        "activex": {
          "type": "integer",
          "minimum": 0
        },
        "document_protection": {
          "type": "integer",
          "minimum": 0
        },
        "macros": {
          "type": "integer",
          "minimum": 0
        },
        "signatures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "mutation_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "blockers",
        "warnings"
      ],
      "properties": {
        "decision": {
          "enum": [
            "safe",
            "safe_with_warnings",
            "refuse_mutation"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "tracked_changes",
              "content_controls",
              "fields",
              "alt_chunks",
              "ole_objects",
              "activex",
              "document_protection",
              "macros",
              "signatures"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "comments",
              "images",
              "text_boxes",
              "merged_cells",
              "hyperlinks",
              "external_relationships",
              "charts",
              "smartart",
              "embedded_packages"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {
                "const": "safe"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              },
              "warnings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "safe_with_warnings"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              },
              "warnings": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "refuse_mutation"
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
