{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "model",
    "output"
  ],
  "properties": {
    "action": {
      "const": "create"
    },
    "output": {
      "type": "string",
      "pattern": "\\.xlsx$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sheets"
      ],
      "properties": {
        "sheets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "cells"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 31
              },
              "state": {
                "enum": [
                  "visible",
                  "hidden",
                  "veryHidden"
                ]
              },
              "cells": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}$"
                },
                "maxProperties": 250000,
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value"
                      ],
                      "properties": {
                        "value": {
                          "oneOf": [
                            {
                              "type": "string",
                              "pattern": "^(?![=])"
                            },
                            {
                              "type": "number"
                            },
                            {
                              "type": "integer"
                            },
                            {
                              "type": "boolean"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "style": {
                          "enum": [
                            "normal",
                            "header",
                            "currency",
                            "percent",
                            "date",
                            "integer",
                            "text"
                          ]
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "formula"
                      ],
                      "properties": {
                        "formula": {
                          "type": "string",
                          "minLength": 2,
                          "maxLength": 32767,
                          "pattern": "^="
                        },
                        "style": {
                          "enum": [
                            "normal",
                            "header",
                            "currency",
                            "percent",
                            "date",
                            "integer",
                            "text"
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              "freeze_panes": {
                "type": "string",
                "pattern": "^(?!A1$)[A-Z]{1,3}[1-9][0-9]{0,6}$"
              },
              "auto_filter": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}(?::[A-Z]{1,3}[1-9][0-9]{0,6})?$"
              },
              "column_widths": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Z]{1,3}$"
                },
                "maxProperties": 16384,
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "row_heights": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[1-9][0-9]{0,6}$"
                },
                "maxProperties": 1048576,
                "additionalProperties": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "merged_ranges": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}:[A-Z]{1,3}[1-9][0-9]{0,6}$"
                }
              }
            }
          }
        },
        "workbook_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        }
      }
    }
  }
}
